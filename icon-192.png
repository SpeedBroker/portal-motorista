<!DOCTYPE html>
<!-- saved from url=(0082)file:///C:/Users/Eduar/OneDrive/Documents/02%20-%20IACAN%20EXCEL/gerador-icon.html -->
<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  
  <title>Gerador de Ícone — Portal do Motorista SS</title>
  <style>
    body {
      background: #1f2937;
      color: #fff;
      font-family: Arial, sans-serif;
      padding: 20px;
      text-align: center;
    }
    h1 { font-size: 20px; margin-bottom: 10px; }
    p { font-size: 13px; color: #9ca3af; margin-bottom: 20px; }
    .botoes { margin-bottom: 20px; }
    button {
      background: #2563eb;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      margin: 0 5px;
    }
    button:hover { background: #1d4ed8; }
    button.ativo { background: #16a34a; }
    .preview {
      display: inline-block;
      background: #fff;
      padding: 20px;
      border-radius: 12px;
      margin-top: 20px;
    }
    canvas {
      border-radius: 50%;
      display: block;
    }
    .aviso {
      background: #7c2d12;
      padding: 15px;
      border-radius: 8px;
      margin-top: 20px;
      text-align: left;
      font-size: 13px;
      line-height: 1.6;
    }
    .aviso strong { color: #fbbf24; }
  </style>
</head>
<body>

  <h1>Gerador de Ícone — Portal do Motorista SS</h1>
  <p>Escolha o tamanho e clique com o botão direito na imagem → Salvar como</p>

  <div class="botoes">
    <button onclick="gerar(512)" id="btn512" class="">512 x 512</button>
    <button onclick="gerar(192)" id="btn192" class="ativo">192 x 192</button>
  </div>

  <div class="preview">
    <canvas id="canvas" width="192" height="192"></canvas>
  </div>

  <div class="aviso">
    <strong>Como salvar:</strong><br>
    1. Clique com o botão DIREITO no ícone acima<br>
    2. Escolha <strong>"Salvar imagem como..."</strong><br>
    3. Salve como <strong>icon-512.png</strong> (quando estiver em 512)<br>
    4. Depois clique em 192x192 e salve como <strong>icon-192.png</strong><br>
    <br>
    5. Suba os dois arquivos pro GitHub
  </div>

  <script>
    function gerar(tamanho) {
      var canvas = document.getElementById('canvas');
      canvas.width = tamanho;
      canvas.height = tamanho;
      var ctx = canvas.getContext('2d');

      // Fundo azul
      ctx.fillStyle = '#2563eb';
      ctx.fillRect(0, 0, tamanho, tamanho);

      // Texto "SS" branco
      ctx.fillStyle = '#ffffff';
      ctx.font = 'bold ' + Math.round(tamanho * 0.5) + 'px Arial, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('SS', tamanho / 2, tamanho / 2 - tamanho * 0.03);

      // Linha decorativa embaixo
      ctx.fillStyle = '#60a5fa';
      ctx.fillRect(tamanho * 0.3, tamanho * 0.72, tamanho * 0.4, tamanho * 0.02);

      // Atualiza botões
      document.getElementById('btn512').className = tamanho === 512 ? 'ativo' : '';
      document.getElementById('btn192').className = tamanho === 192 ? 'ativo' : '';
    }

    // Gera o 512 por padrão
    gerar(512);
  </script>


</body></html>